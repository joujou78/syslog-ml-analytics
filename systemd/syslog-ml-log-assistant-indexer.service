[Unit]
Description=Syslog ML Log Assistant indexer (embed events into OpenSearch for semantic search)
After=network.target clickhouse-server.service opensearch.service ollama.service
Wants=clickhouse-server.service opensearch.service ollama.service

[Service]
Type=simple
User=syslog-ml
Group=syslog-ml
WorkingDirectory=/opt/syslog-ml/ml
ExecStart=/opt/syslog-ml/venv/bin/python log_assistant_indexer.py
EnvironmentFile=-/etc/syslog-ml/clickhouse.env
Environment=CLICKHOUSE_HOST=localhost
Environment=CLICKHOUSE_PORT=8123
Environment=OPENSEARCH_URL=http://localhost:9200
Environment=OPENSEARCH_INDEX=syslog_ml_log_events
Environment=OLLAMA_URL=http://localhost:11434
Environment=OLLAMA_EMBED_MODEL=nomic-embed-text
Environment=LOG_ASSISTANT_CHECKPOINT_FILE=/var/lib/syslog-ml/log_assistant_indexer.checkpoint
# CORRECTED after real-world evidence on net-flow (nginx error log showed
# "upstream timed out ... /api/log-assistant/ask" recurring even AFTER this
# was added): Nice/CPUWeight on THIS service does not fix the contention it
# was meant to fix, and the original comment here was wrong about why. This
# process (log_assistant_indexer.py) does not itself do the embedding
# computation -- it makes an HTTP call to Ollama and blocks, using
# negligible CPU while waiting. The actual CPU-heavy work happens inside
# Ollama's own `llama-server` subprocess (a child of ollama.service, a
# DIFFERENT systemd unit/cgroup entirely), which is what actually contends
# with the chat model's own llama-server process for cores. Deprioritizing
# this service's scheduling doesn't touch that contention at all. Left in
# place because it's harmless (this process does have some real, if minor,
# CPU cost of its own -- ClickHouse result parsing, hashing, JSON/bulk
# formatting), but do not rely on it for the chat-latency problem -- see
# INDEXER_BATCH_SIZE below (and ml/log_assistant_indexer.py's
# INDEXER_BATCH_SLEEP_SECONDS docstring) for the setting that actually
# bounds how long Ollama's embed subprocess can run uninterrupted.
Nice=15
CPUWeight=20
# THE lever that actually works, if you see this contention in practice
# (not set by default -- BATCH_SIZE=200 is fine on hosts without a
# concurrently-used interactive chat model): shrinking INDEXER_BATCH_SIZE
# via a `systemctl edit` override (e.g. to 20) means Ollama's embed
# llama-server process only holds the CPU for a fraction of the default
# ~13s per batch before INDEXER_BATCH_SLEEP_SECONDS's pause gives every
# core a real, complete idle window -- during which a concurrent chat
# request runs uncontended. Trades a proportionally slower backfill (more
# batches means the per-batch sleep fires more often) for a much shorter
# worst-case wait for an interactive request.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
