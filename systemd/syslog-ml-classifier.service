[Unit]
Description=Syslog ML classifier (tail raw.jsonl, classify, write to ClickHouse)
After=network.target clickhouse-server.service
Wants=clickhouse-server.service

[Service]
Type=simple
User=syslog-ml
Group=syslog-ml
WorkingDirectory=/opt/syslog-ml/ml
ExecStart=/opt/syslog-ml/venv/bin/python consumer.py
EnvironmentFile=-/etc/syslog-ml/clickhouse.env
Environment=SYSLOG_ML_LOG_FILE=/var/log/syslog-ml/raw.jsonl
Environment=SYSLOG_ML_OFFSET_FILE=/var/lib/syslog-ml/consumer.offset
Environment=STATE_DB=/var/lib/syslog-ml/state.db
Environment=CLICKHOUSE_HOST=localhost
Environment=CLICKHOUSE_PORT=8123
Environment=MODEL_PATH=/var/lib/syslog-ml/classifier.joblib
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
