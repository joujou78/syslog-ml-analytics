# Copy to /etc/syslog-ml/email.env, fill in real values, and:
#   chmod 600 /etc/syslog-ml/email.env
#   chown syslog-ml:syslog-ml /etc/syslog-ml/email.env
# Contains secrets (SMTP_PASSWORD) -- kept out of the unit files themselves
# (world-readable by default) via systemd's EnvironmentFile=, same as
# resolver.env/clickhouse.env. Read by ml/emailer.py, used by both
# evaluate_alerts.py (per-firing alert emails) and daily_digest.py.
#
# Point this at an SMTP server/relay you already have -- your own mail
# server, Office 365, Gmail with an app password, etc. No new account or
# API key needed.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# true for STARTTLS on a plaintext-then-upgraded connection (the common
# case for port 587). Set SMTP_USE_SSL=true instead (and leave this true
# or false, it's ignored either way) if your server needs implicit TLS
# from the start (typically port 465) -- see emailer.py's own comment.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_ADDRESS=syslog-ml@example.com

# Comma-separated recipient list for every alert rule that fires.
ALERT_EMAIL_RECIPIENTS=ops@example.com

# Comma-separated recipient list for the daily digest. Falls back to
# ALERT_EMAIL_RECIPIENTS above if left unset -- only set this separately
# if the digest's audience should differ (e.g. also includes management).
DIGEST_EMAIL_RECIPIENTS=
