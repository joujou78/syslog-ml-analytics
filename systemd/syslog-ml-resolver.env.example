# Copy to /etc/syslog-ml/resolver.env, fill in real values, and:
#   chmod 600 /etc/syslog-ml/resolver.env
#   chown syslog-ml:syslog-ml /etc/syslog-ml/resolver.env
# Contains secrets -- kept out of the unit file itself (which is
# world-readable by default) via systemd's EnvironmentFile=.

# Must point at the SAME Postgres database as web/backend's
# SYSLOG_ML_DATABASE_URL -- but note the different URL scheme: this script
# uses psycopg2 (sync), which takes a plain "postgresql://" URL, while the
# web app's SQLAlchemy config uses "postgresql+asyncpg://". Same host/db/
# user/password, different prefix.
DATABASE_URL=postgresql://syslog_ml:CHANGE_ME@localhost:5432/syslog_ml

# Must be the SAME value as web/backend's SYSLOG_ML_CREDENTIAL_ENCRYPTION_KEY
# -- this is what lets this process decrypt the community/passphrase
# columns the web app encrypted. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME
