[Unit]
Description=Syslog ML daily digest email (one-shot, triggered by syslog-ml-daily-digest.timer)
After=network.target clickhouse-server.service postgresql.service

[Service]
Type=oneshot
User=syslog-ml
Group=syslog-ml
WorkingDirectory=/opt/syslog-ml/ml
ExecStart=/opt/syslog-ml/venv/bin/python daily_digest.py
EnvironmentFile=/etc/syslog-ml/resolver.env
EnvironmentFile=-/etc/syslog-ml/clickhouse.env
EnvironmentFile=-/etc/syslog-ml/email.env
Environment=CLICKHOUSE_HOST=localhost
Environment=CLICKHOUSE_PORT=8123
