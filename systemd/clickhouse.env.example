# Optional. Only needed if you set a password on ClickHouse's default user
# (the install guide's default setup runs password-less on localhost).
# Copy to /etc/syslog-ml/clickhouse.env if/when you do:
#   chmod 600 /etc/syslog-ml/clickhouse.env
#   chown syslog-ml:syslog-ml /etc/syslog-ml/clickhouse.env
# Shared by both syslog-ml-classifier.service and syslog-ml-resolver.service.

CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
