# systemd override for the packaged snmptrapd.service, so traps get
# logged via syslog (-Lsd) instead of their default destination -- that's
# what makes them show up in /var/log/syslog-ml/raw.jsonl.
#
# Confirmed working on Ubuntu 22.04 (net-snmp 5.9.1): the packaged unit's
# ExecStart is `/usr/sbin/snmptrapd -LOw -f udp:162 udp6:162` (check
# yours with `systemctl cat snmptrapd` first) -- this override changes
# only the logging flag (-LOw -> -Lsd), keeping everything else
# identical. Do NOT add a -p/pidfile flag: the packaged unit uses
# Type=notify with no PIDFile=, and the service's user (Debian-snmp on
# Ubuntu) typically can't write one anyway.
#
# Usage:
#   sudo mkdir -p /etc/systemd/system/snmptrapd.service.d
#   sudo tee /etc/systemd/system/snmptrapd.service.d/override.conf > /dev/null <<'EOF'
#   [paste this file's [Service] block]
#   EOF
#   sudo systemctl daemon-reload
#   sudo systemctl restart snmptrapd.socket

[Service]
ExecStart=
ExecStart=/usr/sbin/snmptrapd -Lsd -f udp:162 udp6:162
