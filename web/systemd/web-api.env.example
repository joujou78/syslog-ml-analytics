# Copy to /etc/syslog-ml/web-api.env, fill in real values, and:
#   chmod 600 /etc/syslog-ml/web-api.env
#   chown syslog-ml:syslog-ml /etc/syslog-ml/web-api.env
# Contains secrets -- kept out of the unit file (world-readable by default).

SYSLOG_ML_DATABASE_URL=postgresql+asyncpg://syslog_ml:CHANGE_ME@localhost:5432/syslog_ml
SYSLOG_ML_CLICKHOUSE_HOST=localhost
SYSLOG_ML_CLICKHOUSE_PORT=8123
# Only needed if you set a password on ClickHouse's default user (the
# install guide's default setup runs password-less on localhost).
SYSLOG_ML_CLICKHOUSE_USER=default
SYSLOG_ML_CLICKHOUSE_PASSWORD=

# Generate with: openssl rand -hex 32
SYSLOG_ML_JWT_SECRET=CHANGE_ME

# Must be the SAME value as systemd/syslog-ml-resolver.env's
# CREDENTIAL_ENCRYPTION_KEY (this is what encrypts SNMP credentials; the
# resolver needs the matching key to decrypt them). Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SYSLOG_ML_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME

# JSON array of allowed origins for the web UI, e.g. the nginx vhost.
SYSLOG_ML_CORS_ORIGINS=["http://YOUR_VM_IP"]
